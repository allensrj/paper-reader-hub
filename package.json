{
  "name": "dsh-paper-board",
  "version": "1.1.0",
  "description": "论文知识库学习看板：论文库、多标签原版 PDF 精读（AI 翻译 / 划线 / 批注）、整篇笔记、论文库总览。DeepSeek Harness 插件。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "serve": "node serve.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "paper",
    "pdf",
    "reader",
    "translation",
    "notes"
  ],
  "homepage": "https://github.com/allensrj/paper-reader-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allensrj/paper-reader-hub.git"
  },
  "author": "allensrj",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.68.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
